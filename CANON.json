    "identity": {
      "id": "identity.catalyst",
      "name": "Catalyst",
      "statement": "Catalyst is the Electron and React desktop product shell that composes, inspects, and authors against one staged AgentExperiments generation.",
      "evidence_refs": [
        "evidence.package",
        "evidence.executive",
        "evidence.electron-main"
      ]
    },
    "anatomical_role": {
      "id": "role.desktop-executive-shell",
      "statement": "Catalyst is a peripheral desktop executive surface: it hosts native lifecycle and renderer interaction while routing canonical runtime and projection semantics to their owners.",
      "evidence_refs": [
        "evidence.executive",
        "evidence.electron-main",
        "evidence.generation"
      ]
    },
    "purpose": [
      {
        "id": "purpose.compose-desktop-experience",
        "statement": "Compose the canonical executive and UGUI-derived experiences into an operable Electron desktop shell.",
        "evidence_refs": [
          "evidence.executive",
          "evidence.electron-main"
        ]
      },
      {
        "id": "purpose.publish-verifiable-quality",
        "statement": "Execute local pinned quality tools and publish deterministic machine reports without converting known failures into green claims.",
        "evidence_refs": [
          "evidence.spec",
          "evidence.quality-common",
          "evidence.quality-lint",
          "evidence.quality-test",
          "evidence.quality-coverage"
        ]
      }
    ],
    "boundaries": [
      {
        "id": "boundary.host-not-authority",
        "kind": "ownership",
        "statement": "Catalyst owns desktop composition, packaging, and interaction, not RUN, Butler, QUINE, Store, Envelope, or UGUI semantic authority.",
        "rejects": [
          "desktop copies of canonical runtime semantics",
          "renderer claims of external effect success",
          "mutable edits to a staged generation"
        ],
        "evidence_refs": [
          "evidence.executive",
          "evidence.generation"
        ]
      },
      {
        "id": "boundary.observed-quality-only",
        "kind": "trust",
        "statement": "Quality reports represent executed TypeScript, ESLint, Vitest, and V8 observations and remain red when exact findings exist.",
        "rejects": [
          "fabricated green reports",
          "discarded skipped tests",
          "coverage percentages without measured totals"
        ],
        "evidence_refs": [
          "evidence.quality-lint",
          "evidence.quality-test",
          "evidence.quality-coverage"
        ]
      }
    ],
    "inputs": [
      {
        "id": "input.ae-generation",
        "source": "A parent-pinned AgentExperiments repository generation",
        "trust": "validated-untrusted",
        "contract": "A staged immutable generation with repository-root and current-generation selection rules.",
        "validation": "Resolve the repository root, stage required artifacts, and select only a completely published generation.",
        "secret_policy": "forbidden",
        "evidence_refs": [
          "evidence.generation"
        ]
      },
      {
        "id": "input.desktop-interaction",
        "source": "Renderer interaction and Electron host events",
        "trust": "validated-untrusted",
        "contract": "Typed desktop intents and bounded host messages admitted by the owning renderer and Electron seams.",
        "validation": "Validate message shape and route the action to its exact owner before mutating host state.",
        "secret_policy": "redacted-at-boundary",
        "evidence_refs": [
          "evidence.executive",
          "evidence.electron-main"
        ]
      },
      {
        "id": "input.quality-source",
        "source": "Catalyst manifests, quality scripts, Desktop configuration, Electron source, renderer source, scripts, and tests",
        "trust": "local-observation",
        "contract": "The deterministic source closure declared by SPEC and collected by scripts/quality/common.mjs.",
        "validation": "Reject symlinks, special files, oversized files, excessive counts, and bytes beyond the configured closure bound.",
        "secret_policy": "forbidden",
        "evidence_refs": [
          "evidence.spec",
          "evidence.quality-common"
        ]
      }
    ],
    "outputs": [
      {
        "id": "output.desktop-shell",
        "target": "Electron desktop users",
        "contract": "A React renderer hosted by an Electron main process over one selected AgentExperiments generation.",
        "freshness": "Current only for the selected fully staged generation and active desktop process.",
        "bounded": "Catalyst exposes host composition and interaction, not ownership of canonical runtime or persistence semantics.",
        "evidence_refs": [
          "evidence.executive",
          "evidence.electron-main",
          "evidence.generation"
        ]
      },
      {
        "id": "output.quality-reports",
        "target": "quality/lint-report.json, quality/test-report.json, and quality/coverage-report.json",
        "contract": "Stable JSON preserving exact lint findings, per-suite test truth, and measured line and branch totals.",
        "freshness": "Default execution atomically replaces reports; --check executes again and accepts only exact stable bytes.",
        "bounded": "Only the declared Catalyst source closure and locally installed pinned tools are observed.",
        "evidence_refs": [
          "evidence.spec",
          "evidence.quality-common",
          "evidence.quality-lint",
          "evidence.quality-test",
          "evidence.quality-coverage"
        ]
