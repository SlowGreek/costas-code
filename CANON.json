        "contract": "agentexperiments-project-canon/1 for catalyst at registry row 19.",
        "freshness": "Current only when schema, registry binding, semantic references, evidence, and handoff validate.",
        "bounded": "Closed structured truth, exactly 17 teaching beats, and explicit residue.",
        "evidence_refs": [
          "evidence.spec"
        ]
      }
